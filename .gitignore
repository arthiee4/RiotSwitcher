# Godot 4+ specific ignores
.godot/
/android/
/ios/

# Imported assets (Godot 4 uses .godot/imported, but legacy or misconfig might leave these)
*.import

# Binary Tools
rcedit-x64.exe

# UPX / linker temp files left by the addon build
/addons/catui-builder/bin/~*

# Vendored addon source repo (has its own .git); only addons/ is shipped
/native/

# Build Artifacts & Backups
*.exe
*.pck
*.tmp
/build/

# User Data & sensitive configs
Data/profiles_data.json
Data/configs.json
user://
UserBackground/
profiles/

# OS specific
.DS_Store
Thumbs.db

# Python
__pycache__/

# Logs
*.log

# Export presets (contains absolute paths)
export_presets.cfg
