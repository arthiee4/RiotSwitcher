[configuration]

entry_symbol = "catui_builder_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://addons/catui-builder/bin/catui_builder.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/catui-builder/bin/catui_builder.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/catui-builder/bin/catui_builder.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/catui-builder/bin/catui_builder.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/catui-builder/bin/catui_builder.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/catui-builder/bin/catui_builder.linux.template_release.arm64.so"
macos.debug.x86_64 = "res://addons/catui-builder/bin/catui_builder.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://addons/catui-builder/bin/catui_builder.macos.template_release.x86_64.dylib"
macos.debug.arm64 = "res://addons/catui-builder/bin/catui_builder.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://addons/catui-builder/bin/catui_builder.macos.template_release.arm64.dylib"
